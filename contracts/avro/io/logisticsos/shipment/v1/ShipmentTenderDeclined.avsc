    { "name": "reasonCode", "type": "string", "doc": "CAPACITY|RATE|SERVICE|EQUIPMENT|OTHER" },
    { "name": "status", "type": "io.logisticsos.shipment.ShipmentStatus" },
    { "name": ["null","string"], "name": "reasonText", "default": null },
