{
  "realm": "logistics-os",
  "enabled": true,
  "displayName": "Logistics OS",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 3600,
  "roles": {
    "realm": [
      { "name": "viewer", "description": "Read-only access" },
      { "name": "operator", "description": "Can trigger one-click actions" },
      { "name": "admin", "description": "Administrative access" }
    ]
  },
  "clients": [
    {
      "clientId": "logistics-os-web",
      "name": "Logistics OS web console",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:8092/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "tenant-1",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "ops",
      "enabled": true,
      "email": "ops@example.com",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "ops", "temporary": false }],
      "realmRoles": ["operator"]
    },
    {
      "username": "viewer",
      "enabled": true,
      "email": "viewer@example.com",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "viewer", "temporary": false }],
      "realmRoles": ["viewer"]
    }
  ]
}
