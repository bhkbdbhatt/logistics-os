{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://logistics-os/editions/schema.json",
  "title": "Logistics OS edition catalog entry",
  "description": "Schema for editions/<name>.yaml — the sellable SKU definition.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "title", "tier", "description", "status", "support_tier", "default_version", "services", "features"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" },
    "title": { "type": "string", "minLength": 3 },
    "tier": { "type": "integer", "minimum": 1 },
    "description": { "type": "string", "minLength": 10 },
    "status": { "type": "string", "enum": ["draft", "ga", "deprecated"] },
    "support_tier": { "type": "string", "enum": ["community", "standard", "premium"] },
    "default_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "channels": {
      "type": "array",
      "items": { "type": "string", "enum": ["stable", "lts", "beta"] },
      "uniqueItems": true
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "module"],
        "properties": {
          "name": { "type": "string" },
          "module": { "type": "string" }
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    }
  }
}